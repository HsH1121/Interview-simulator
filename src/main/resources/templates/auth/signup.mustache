<!doctype html>
<html lang="ko">
<head>
    <link rel="stylesheet" href="/css/app.css">

    <meta charset="utf-8">
    <title>회원가입</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <!-- CSRF meta: 스프링이 주입한 값 바인딩 -->
    <meta name="csrf-header" content="{{_csrf.headerName}}">
    <meta name="csrf-param"  content="{{_csrf.parameterName}}">
    <meta name="csrf-token"  content="{{_csrf.token}}">

    <style>
        body { max-width: 480px; margin: 40px auto; font-family: system-ui, Arial; }
        h1 { font-size: 20px; }
        form { display: grid; gap: 12px; }
        label { display: grid; gap: 6px; font-size: 14px; }
        input { padding: 10px; font-size: 14px; }
        button { padding: 10px 14px; cursor: pointer; }
        .msg { margin-top: 14px; white-space: pre-wrap; }
        .ok { color: #0a7c2f; }
        .err { color: #b00020; }
    </style>
</head>
<body>
<h1>회원가입</h1>

<form id="signupForm">
    <label>
        이메일
        <input type="email" name="email" required placeholder="you@example.com">
    </label>
    <label>
        비밀번호
        <input type="password" name="password" required minlength="8" maxlength="100">
    </label>
    <label>
        닉네임
        <input type="text" name="nickname" required maxlength="40">
    </label>

    <!-- 폼 제출(전통 방식) 대비용 히든 CSRF 필드 -->
    <input type="hidden" name="{{_csrf.parameterName}}" value="{{_csrf.token}}">

    <button type="submit">가입하기</button>
</form>

<div id="msg" class="msg"></div>

<p style="margin-top:20px">
    <a href="/auth/login">이미 계정이 있으신가요? 로그인</a>
</p>

<script src="/js/auth.js"></script>
<script>
    // 회원가입 폼 핸들러 등록
    window.Auth.initSignup('/api/auth/signup');
</script>
</body>
</html>
